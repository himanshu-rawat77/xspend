# ==============================================================================
# StockSpend Environment Configuration (.env)
# Note: Variables prefixed with EXPO_PUBLIC_ are accessible in React Native code.
# ==============================================================================

# ─── 1. Solana RPC Configuration ──────────────────────────────────────────────
# Helius RPC API Key (Get a free key with 100k req/day at https://helius.dev)
EXPO_PUBLIC_HELIUS_API_KEY=demo

# Custom Solana RPC Endpoint (Optional - overrides default Helius endpoint if set)
# EXPO_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Default Solana Cluster: 'mainnet-beta' or 'devnet'
EXPO_PUBLIC_SOLANA_NETWORK=mainnet-beta

# ─── 2. Jupiter DEX Aggregator API ───────────────────────────────────────────
# Jupiter Swap API v6 Endpoint (free public endpoint, no key required)
EXPO_PUBLIC_JUPITER_QUOTE_API=https://quote-api.jup.ag/v6
EXPO_PUBLIC_JUPITER_PRICE_API=https://price.jup.ag/v4/price

# ─── 3. Pyth Network Price Oracles ───────────────────────────────────────────
# Pyth Hermes REST Endpoint
EXPO_PUBLIC_PYTH_HERMES_URL=https://hermes.pyth.network

# ─── 4. App & Merchant Metadata ──────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=StockSpend
EXPO_PUBLIC_APP_URL=https://stockspend.app
EXPO_PUBLIC_DEFAULT_MERCHANT_WALLET=7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosg4B9
